<div class="cur" data-cur-root aria-hidden="true">
	<span class="cur__main" data-cur-main>View</span>
	<span class="cur__hint" data-cur-hint aria-hidden="true"></span>
</div>

<style>
	.cur {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 120;
		pointer-events: none;
		opacity: 0;
	}
	.cur__main {
		display: inline-block;
	}
	.cur__hint {
		display: none;
	}

	/* ------- presentations ------- */

	/* compact circle chip for short verbs (OPEN / FILTER / TOP …) */
	.cur--chip {
		width: 88px;
		height: 88px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: var(--fg);
		color: var(--bg);
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		overflow: hidden;
	}
	.cur--chip .cur__main {
		line-height: 1;
	}

	/* expanding pill that carries a title / label + small directional hint */
	.cur--pill {
		min-width: 128px;
		min-height: 104px;
		padding: 0.55rem 3rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: var(--fg);
		color: var(--bg);
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.15rem, 1.8vw, 1.7rem);
		letter-spacing: 0.012em;
		line-height: 1;
		white-space: nowrap;
		overflow: hidden;
		text-align: center;
	}
	.cur--pill .cur__hint {
		display: block;
		position: absolute;
		right: 1.05rem;
		top: 50%;
		translate: 0 -50%;
		font-family: var(--font-ui);
		font-style: normal;
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1;
		opacity: 0.5;
	}

	@media (pointer: coarse), (hover: none) {
		.cur {
			display: none;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { onBoot, scoped, reducedMotion, finePointer, cleanup } from '../scripts/app';

	const ACTIONABLE = 'a, button, [role="button"], input, textarea, select, summary, label[for], [data-cursor]';

	/** verb chips are short; everything with a data-cursor-title becomes a pill */
	const HINTS: Record<string, string> = {
		title: '↗',
		drag: '↔',
	};

	function init(): void {
		const root = document.querySelector<HTMLElement>('[data-cur-root]');
		if (!root) return;
		if (!finePointer() || reducedMotion()) {
			document.documentElement.classList.remove('has-cursor');
			return;
		}

		const main = root.querySelector<HTMLElement>('[data-cur-main]');
		const hint = root.querySelector<HTMLElement>('[data-cur-hint]');
		if (!main || !hint) return;

		/* Only hide the native cursor once the custom one is fully set up;
		   if anything below throws, the user keeps a working native cursor. */
		scoped(root, () => {
			document.documentElement.classList.add('has-cursor');

			gsap.set(root, { xPercent: -50, yPercent: -50, x: -1000, y: -1000 });
			gsap.set(root, { autoAlpha: 0 });

			const posX = gsap.quickTo(root, 'x', { duration: 0.5, ease: 'power3.out' });
			const posY = gsap.quickTo(root, 'y', { duration: 0.5, ease: 'power3.out' });

			const state = { mode: 'idle', text: '', shown: false };
			let lastBox = { w: 0, h: 0 };

			const clearSize = (): void => {
				root.style.removeProperty('width');
				root.style.removeProperty('height');
			};

			const isPill = (mode: string): mode is 'title' | 'drag' => mode === 'title' || mode === 'drag';

			/* paint the pill/chip with its content and return its natural size */
			const compose = (mode: 'chip' | 'title' | 'drag', text: string): { w: number; h: number } => {
				root.className = `cur cur--${isPill(mode) ? 'pill' : 'chip'}`;
				main.textContent = text;
				hint.textContent = HINTS[mode] ?? '';
				clearSize();
				return { w: root.offsetWidth, h: root.offsetHeight };
			};

			/* Enter a chip / title / drag state. First show scales in; swaps
			   between visible states tween the box so the pill grows or
			   shrinks to fit the new text instead of popping. */
			const present = (mode: 'chip' | 'title' | 'drag', text: string): void => {
				const first = !state.shown;
				gsap.killTweensOf(root);
				const to = compose(mode, text);

				if (first) {
					root.style.width = `${to.w}px`;
					root.style.height = `${to.h}px`;
					state.shown = true;
					gsap.fromTo(
						root,
						{ autoAlpha: 0, scale: 0.5 },
						{ autoAlpha: 1, scale: 1, duration: 0.5, ease: 'expo.out', onComplete: clearSize },
					);
				} else {
					const from = lastBox.w ? lastBox : to;
					root.style.width = `${from.w}px`;
					root.style.height = `${from.h}px`;
					gsap.to(root, {
						width: to.w,
						height: to.h,
						autoAlpha: 1,
						duration: 0.65,
						ease: 'expo.out',
						onComplete: clearSize,
					});
				}
				lastBox = to;
			};

			const hide = (): void => {
				state.shown = false;
				gsap.killTweensOf(root);
				clearSize();
				gsap.to(root, { autoAlpha: 0, scale: 0.5, duration: 0.28, ease: 'power2.in' });
			};

			const setMode = (mode: 'idle' | 'chip' | 'title' | 'drag', text = ''): void => {
				if (state.mode === mode && state.text === text) return;
				state.mode = mode;
				state.text = text;
				if (mode === 'idle') hide();
				else present(mode, text);
			};

			const onMove = (e: MouseEvent): void => {
				posX(e.clientX);
				posY(e.clientY);
			};

			const hoverTarget = (e: Event): Element | null => {
				const t = e.target as Element | null;
				return t ? t.closest(ACTIONABLE) : null;
			};

			const onOver = (e: MouseEvent): void => {
				const el = hoverTarget(e);
				if (!el) {
					setMode('idle');
					return;
				}
				const custom = el.closest('[data-cursor]') as HTMLElement | null;
				const title = custom?.dataset.cursorTitle;
				const verb = (custom?.dataset.cursor ?? '').toLowerCase();
				if (title) setMode('title', title);
				else if (verb === 'drag') setMode('drag', 'Drag');
				else if (verb) setMode('chip', verb);
				else setMode('chip', 'Open');
			};

			const onOut = (e: MouseEvent): void => {
				const next = e.relatedTarget as Element | null;
				if (next && next.closest(ACTIONABLE)) return;
				setMode('idle');
			};

			const onLeave = (): void => {
				gsap.to(root, { autoAlpha: 0, duration: 0.25 });
			};
			const onEnter = (): void => {
				state.shown = false;
				gsap.to(root, { autoAlpha: 1, duration: 0.3 });
			};

			window.addEventListener('mousemove', onMove, { passive: true });
			window.addEventListener('mouseover', onOver, { passive: true });
			window.addEventListener('mouseout', onOut, { passive: true });
			document.documentElement.addEventListener('mouseleave', onLeave);
			document.documentElement.addEventListener('mouseenter', onEnter);

			cleanup(() => {
				window.removeEventListener('mousemove', onMove);
				window.removeEventListener('mouseover', onOver);
				window.removeEventListener('mouseout', onOut);
				document.documentElement.removeEventListener('mouseleave', onLeave);
				document.documentElement.removeEventListener('mouseenter', onEnter);
				document.documentElement.classList.remove('has-cursor');
			});
		});
	}

	onBoot(init);
</script>
