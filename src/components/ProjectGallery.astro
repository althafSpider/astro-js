---
import ImageReveal from './ImageReveal.astro';
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<div class="gallery">
	{
		project.body.map((block, i) => {
			/* ---------------- text ---------------- */
			if (block.type === 'text') {
				if (block.pull) {
					return (
						<p class="gallery__pull" data-fx-lines>
							<span class="l-line"><span class="l-i">{block.body}</span></span>
						</p>
					);
				}
				return (
					<div class="gallery__text">
						{block.kicker && <p class="label gallery__kicker" data-fx="fade">{block.kicker}</p>}
						<p class="gallery__body" data-fx="fade">{block.body}</p>
					</div>
				);
			}

			const caption = block.type !== 'duo' ? block.caption : undefined;
			const n = String(i + 1).padStart(2, '0');

			/* ---------------- full bleed ---------------- */
			if (block.type === 'full') {
				return (
					<figure class="gallery__figure">
						<ImageReveal
							photo={block.photo}
							frameClass="w-full h-[62vh] sm:h-[76vh] lg:h-[88vh]"
							width={2600}
							height={1500}
							sizes="100vw"
							reveal
							grow
							parallax={7}
						/>
						{caption && <figcaption class="label gallery__cap"><span class="num">{n}</span> — {caption}</figcaption>}
					</figure>
				);
			}

			/* ---------------- constrained band ---------------- */
			if (block.type === 'band') {
				return (
					<figure class="gallery__figure">
						<div class="wrap">
							<ImageReveal
								photo={block.photo}
								frameClass="w-full aspect-[3/2] sm:aspect-[8/5]"
								width={2000}
								height={1300}
								sizes="(min-width:768px) 84vw, 100vw"
								reveal
								grow
								parallax={6}
							/>
							{caption && <figcaption class="label gallery__cap"><span class="num">{n}</span> — {caption}</figcaption>}
						</div>
					</figure>
				);
			}

			/* ---------------- wide editorial ---------------- */
			if (block.type === 'wide') {
				return (
					<figure class="gallery__figure">
						<div class="wrap gallery__wide">
							<ImageReveal
								photo={block.photo}
								frameClass="w-full aspect-[16/10] lg:aspect-[16/9]"
								width={2200}
								height={1400}
								sizes="(min-width:1024px) 76vw, 100vw"
								reveal
								grow
								parallax={6}
							/>
							{caption && <figcaption class="label gallery__cap"><span class="num">{n}</span> — {caption}</figcaption>}
						</div>
					</figure>
				);
			}

			/* ---------------- centered portrait ---------------- */
			if (block.type === 'portrait') {
				return (
					<figure class="gallery__figure">
						<div class="wrap gallery__portrait">
							<ImageReveal
								photo={block.photo}
								frameClass="w-full max-w-[24rem] sm:max-w-[28rem] mx-auto aspect-[3/4]"
								width={1300}
								height={1700}
								crop="faces"
								sizes="(min-width:768px) 460px, 84vw"
								reveal
								grow
								parallax={5}
							/>
							{caption && <figcaption class="label gallery__cap"><span class="num">{n}</span> — {caption}</figcaption>}
						</div>
					</figure>
				);
			}

			/* ---------------- duo ---------------- */
			return (
				<figure class="gallery__figure">
					<div class="wrap gallery__duo">
						<ImageReveal
							photo={block.a}
							frameClass="w-full aspect-[3/4] sm:aspect-[4/5]"
							width={1400}
							height={1800}
							sizes="(min-width:768px) 44vw, 100vw"
							reveal
							grow
							parallax={5}
						/>
						<ImageReveal
							photo={block.b}
							frameClass="w-full aspect-[3/4] sm:aspect-[4/5] sm:mt-[6rem]"
							width={1400}
							height={1800}
							sizes="(min-width:768px) 44vw, 100vw"
							reveal
							grow
							parallax={5}
						/>
					</div>
				</figure>
			);
		})
	}
</div>

<style>
	.gallery {
		display: flex;
		flex-direction: column;
		gap: clamp(4.5rem, 10vh, 8rem);
		padding-top: clamp(4rem, 9vh, 7rem);
	}

	/* ---------- text ---------- */
	.gallery__text {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.2rem;
	}
	.gallery__kicker {
		color: var(--fg);
	}
	.gallery__body {
		margin: 0;
		max-width: 38rem;
		color: var(--mute);
		font-size: 1rem;
		line-height: 1.9;
	}

	/* pull quote */
	.gallery__pull {
		margin: 0;
		max-width: 30ch;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 300;
		font-size: clamp(1.9rem, 4vw, 3.4rem);
		line-height: 1.25;
		letter-spacing: -0.01em;
	}
	.gallery__pull .l-line {
		overflow: clip;
	}

	@media (min-width: 900px) {
		.gallery__text {
			grid-template-columns: minmax(9rem, 14rem) 1fr;
			column-gap: 3rem;
			align-items: baseline;
		}
		.gallery__pull {
			margin-inline: min(20vw, 16rem);
		}
	}

	/* ---------- figures ---------- */
	.gallery__figure {
		margin: 0;
	}
	.gallery__figure > .wrap {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.gallery__wide {
		max-width: none;
	}
	@media (min-width: 1100px) {
		.gallery__wide {
			margin-left: calc(var(--pad-x) * 0.5);
		}
		.gallery__portrait {
			margin-right: calc(var(--pad-x) * 0.35);
		}
	}

	.gallery__duo {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.2rem;
	}
	@media (min-width: 768px) {
		.gallery__duo {
			grid-template-columns: 1fr 1fr;
			column-gap: clamp(1.6rem, 4vw, 4rem);
			align-items: start;
		}
	}

	/* ---------- captions ---------- */
	.gallery__cap {
		color: var(--mute);
	}
	.gallery__cap .num {
		color: var(--fg);
	}
</style>
